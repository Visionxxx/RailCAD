{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@fixtures/*": ["fixtures/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["packages/*/src", "packages/*/tests", "apps/web/src", "apps/web/tests", "apps/web/*.ts", "tests", "fixtures", "playwright.config.ts", "vitest.config.ts"]
}
